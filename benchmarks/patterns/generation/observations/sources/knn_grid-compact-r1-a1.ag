from math import sqrt

train, test = [], []
for i, row in enumerate(c("samples.csv")):
    fold = row$fold
    sample = (fold, int(row$x), int(row$y), row$label, i)
    (test if fold == "test" else train).append(sample)

def predict(sample, pool, k, metric, weights):
    _, a, b, _, _ = sample
    neighbors = []
    for _, x, y, label, i in pool:
        dx, dy = x - a, y - b
        d = sqrt(dx * dx + dy * dy) if metric == "euclidean" else abs(dx) + abs(dy)
        neighbors.append((d, i, label))
    selected = t(neighbors, k)
    zeros = weights == "distance" and selected[0][0] == 0
    scores = {}
    for d, _, label in selected:
        if zeros and d != 0:
            break
        vote = 1 if zeros or weights == "uniform" else 1 / d
        scores[label] = scores.get(label, 0) + vote
    return min(scores, key=lambda label: (-scores[label], label))

pools = {fold: [s for s in train if s[0] != fold] for fold in ("0", "1", "2")}
grid = []
for k in (1, 3, 5):
    for metric in ("euclidean", "manhattan"):
        for weights in ("uniform", "distance"):
            correct = sum(predict(s, pools[s[0]], k, metric, weights) == s[3] for s in train)
            grid.append(d{k,metric,weights,correct})

best = max(range(len(grid)), key=lambda i: grid[i]["correct"])
config = grid[best]
predictions = [predict(s, train, config$k, config$metric, config$weights) for s in test]
test_correct = sum(p == s[3] for p, s in zip(predictions, test))
wj(d{grid,best,predictions,test_correct})