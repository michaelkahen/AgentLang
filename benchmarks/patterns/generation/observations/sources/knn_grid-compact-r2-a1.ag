from math import hypot

rows = [(int(a$x), int(a$y), a$label, a$fold) for a in c("samples.csv")]
train = [a for a in rows if a[3] != "test"]
test = [a for a in rows if a[3] == "test"]

def predict(a, pool, k, metric, weights):
    def distance(p):
        dx, dy = a[0] - p[0], a[1] - p[1]
        return hypot(dx, dy) if metric == "euclidean" else abs(dx) + abs(dy)

    neighbors = t(((distance(p), p[2]) for p in pool), k, lambda q: q[0])
    weighted = weights == "distance"
    zeros = weighted and neighbors[0][0] == 0
    scores = {}
    for d, label in neighbors:
        if zeros and d:
            break
        scores[label] = scores.get(label, 0) + (1 / d if weighted and not zeros else 1)
    return min(scores, key=lambda label: (-scores[label], label))

pools = {f: [a for a in train if a[3] != f] for f in ("0", "1", "2")}
grid = []
for k in (1, 3, 5):
    for metric in ("euclidean", "manhattan"):
        for weights in ("uniform", "distance"):
            correct = sum(predict(a, pools[a[3]], k, metric, weights) == a[2] for a in train)
            grid.append(d{k,metric,weights,correct})

best = max(range(len(grid)), key=lambda i: grid[i]["correct"])
cfg = grid[best]
predictions = [predict(a, train, cfg$k, cfg$metric, cfg$weights) for a in test]
test_correct = sum(label == a[2] for label, a in zip(predictions, test))
wj(d{grid,best,predictions,test_correct})