import json

def nonnegative(n):
    return type(n) is int and n >= 0

def invalid_constant(value):
    raise ValueError(value)

events = {}
with open('events.jsonl', encoding='utf-8') as f:
    for line in f:
        try:
            e = json.loads(line, parse_constant=invalid_constant)
        except (ValueError, RecursionError):
            continue
        if not isinstance(e, dict):
            continue
        run, seq, kind = e.get('run'), e.get('seq'), e.get('type')
        if isinstance(run, str) and run and nonnegative(seq) and kind in (
            'item.completed', 'turn.completed', 'turn.failed'
        ):
            events.setdefault(run, {}).setdefault(seq, e)

runs = []
totals = dict(ok=0, failed=0, open=0, commands=0, input_tokens=0, output_tokens=0)
for run in sorted(events):
    status, last_message = 'open', None
    commands = input_tokens = output_tokens = 0
    for _, e in sorted(events[run].items()):
        if e$type == 'item.completed':
            item = e.get('item')
            if isinstance(item, dict):
                kind = item.get('type')
                if kind == 'command_execution':
                    commands += 1
                elif kind == 'agent_message' and isinstance(item.get('text'), str):
                    last_message = item$text
        else:
            status = 'ok' if e$type == 'turn.completed' else 'failed'
            usage = e.get('usage')
            if status == 'ok' and isinstance(usage, dict):
                a, b = usage.get('input_tokens'), usage.get('output_tokens')
                input_tokens = a if nonnegative(a) else 0
                output_tokens = b if nonnegative(b) else 0
            break
    report = d{run,status,last_message,commands,input_tokens,output_tokens}
    runs.append(report)
    totals[status] += 1
    for key in ('commands', 'input_tokens', 'output_tokens'):
        totals[key] += report[key]

wj(d{runs,totals})