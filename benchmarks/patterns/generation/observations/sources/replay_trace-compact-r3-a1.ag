import json

def natural(n):
    return type(n) is int and n >= 0

def reject_constant(value):
    raise ValueError(value)

events = {}
with open('events.jsonl', encoding='utf-8') as f:
    for line in f:
        try:
            e = json.loads(line, parse_constant=reject_constant)
        except (ValueError, RecursionError):
            continue
        if not isinstance(e, dict):
            continue
        run, seq, kind = e.get('run'), e.get('seq'), e.get('type')
        if isinstance(run, str) and run and natural(seq) and kind in (
            'item.completed', 'turn.completed', 'turn.failed'
        ):
            events.setdefault(run, {}).setdefault(seq, e)

runs = []
totals = dict.fromkeys(('ok', 'failed', 'open', 'commands', 'input_tokens', 'output_tokens'), 0)
for run in sorted(events):
    status, last_message = 'open', None
    commands = input_tokens = output_tokens = 0
    for _, e in sorted(events[run].items()):
        if e$type == 'turn.failed':
            status = 'failed'
            break
        if e$type == 'turn.completed':
            status = 'ok'
            usage = e.get('usage')
            if isinstance(usage, dict):
                i, o = usage.get('input_tokens'), usage.get('output_tokens')
                input_tokens = i if natural(i) else 0
                output_tokens = o if natural(o) else 0
            break
        item = e.get('item')
        if isinstance(item, dict):
            kind = item.get('type')
            if kind == 'command_execution':
                commands += 1
            elif kind == 'agent_message' and isinstance(item.get('text'), str):
                last_message = item$text
    runs.append(d{run,status,last_message,commands,input_tokens,output_tokens})
    totals[status] += 1
    for field in ('commands', 'input_tokens', 'output_tokens'):
        totals[field] += runs[-1][field]

wj(d{runs,totals})