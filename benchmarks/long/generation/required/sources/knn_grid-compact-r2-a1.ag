from math import sqrt

rows = [(row["fold"], int(row["x"]), int(row["y"]), row["label"])
        for row in c("samples.csv")]
train = rows:w _[0] != "test":l
holdout = rows:w _[0] == "test":l
pools = {fold: [row for row in train if row[0] != fold]
         for fold in {row[0] for row in train}}

def predict(row, pool, k, metric, weights):
    _, x, y, _ = row
    neighbors = []
    for _, px, py, label in pool:
        dx, dy = x - px, y - py
        distance = sqrt(dx * dx + dy * dy) if metric == "euclidean" else abs(dx) + abs(dy)
        neighbors.append((distance, label))
    neighbors.sort(key=lambda neighbor: neighbor[0])
    zeros_only = weights == "distance" and neighbors[0][0] == 0
    scores = {}
    for distance, label in neighbors[:k]:
        if zeros_only and distance != 0:
            break
        vote = 1 if weights == "uniform" or zeros_only else 1 / distance
        scores[label] = scores.get(label, 0) + vote
    return min(scores, key=lambda label: (-scores[label], label))

grid = []
for k in (1, 3, 5):
    for metric in ("euclidean", "manhattan"):
        for weights in ("uniform", "distance"):
            correct = sum(predict(row, pools[row[0]], k, metric, weights) == row[3]
                          for row in train)
            grid.append(dict(k=k, metric=metric, weights=weights, correct=correct))

best = max(range(len(grid)), key=lambda index: grid[index]["correct"])
choice = grid[best]
predictions = [predict(row, train, choice["k"], choice["metric"], choice["weights"])
               for row in holdout]
wj(dict(grid=grid, best=best, predictions=predictions,
        test_correct=sum(label == row[3] for label, row in zip(predictions, holdout))))